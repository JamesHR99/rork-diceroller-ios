<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The night is played entirely on the device. Nothing leaves it: no
	  network calls, no analytics, no accounts, no identifiers. The only
	  required-reason API the binary touches is UserDefaults, which holds
	  the two volume sliders, the "skip the tutorial" flag, the single
	  saved run, the chains you have discovered, and the local records.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!--
				  CA92.1 - defaults readable only by this app, used solely
				  to keep the player's own settings and progress. No App
				  Group, no shared suite, no third-party wrapper.
				-->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
